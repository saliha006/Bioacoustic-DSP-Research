# Use the service_role key here (not anon/publishable) — this pipeline runs
# locally and needs to bypass RLS to insert rows. The anon key stays in
# website/.env only, scoped by RLS policies for the frontend.
SUPABASE_URL=
SUPABASE_KEY=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_PUBLIC_URL_BASE=

# Xeno-canto API v3 key for fetch_example_calls (register a free account at
# xeno-canto.org, verify email, copy the key from your account page)
XENO_CANTO_API_KEY=
